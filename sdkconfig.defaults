CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_SO_RCVBUF=y
# Proxy (UDP 22, 9000, HTTP server) + winject-l3 (radio console and d-plane,
# manager console, upstreams, 2 for its reactor's wake pipe).
CONFIG_LWIP_MAX_SOCKETS=24

# Two app slots for POST /update/p4 with rollback (as the proxy's app), plus
# a SPIFFS partition holding /winject/winject.conf.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
